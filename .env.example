# =============================================================================
# IMÓVELHUB - Variáveis de Ambiente de Exemplo (.env.example)
# Copie este arquivo para .env e preencha com as credenciais reais do seu projeto.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vite) - Prefixo VITE_ obrigatório para exposição no cliente
# -----------------------------------------------------------------------------
# URL do projeto Supabase (ex: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Chave Anon/Public do Supabase (para operações públicas e autenticação)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# URL da API Express (usado em ambiente de desenvolvimento local)
VITE_API_URL=http://localhost:3001/api

# Habilitar fallback para o backend Express local (true ou false)
VITE_USE_EXPRESS_FALLBACK=false

# -----------------------------------------------------------------------------
# Backend Express & Scripts de Migração (server/)
# -----------------------------------------------------------------------------
PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# String de conexão PostgreSQL direta do Supabase (para scripts de migração)
DATABASE_URL=postgres://postgres.your-project:your-password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
